// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  password String
  name     String
  role     String    @default("CLIENT") // CLIENT or ADMIN
  requests Request[]
  orders   Order[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String
  category    String
  year        String?
  orderItems  OrderItem[]
}

model Order {
  id          Int         @id @default(autoincrement())
  status      String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED, REJECTED
  total       Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  adminComment String?
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  price     Float
}

model Request {
  id          Int      @id @default(autoincrement())
  type        String   // REPAIR, APPRAISAL, BUY
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  description String
  adminComment String?  // Повідомлення від адміністратора
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}
